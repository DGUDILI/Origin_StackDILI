# ──────────────────────────────────────────────────────────────────────────────
# DGUDILI Frontend 환경 변수
#
# 사용법:
#   개발  : 이 파일을 .env.local로 복사 (Vite proxy가 /api를 localhost:8000으로 전달)
#   프로덕션: VITE_API_BASE_URL을 실제 ALB/CloudFront 도메인으로 설정
# ──────────────────────────────────────────────────────────────────────────────

# 백엔드 API 기본 URL
# 개발  : 비워두면 Vite proxy가 자동 처리 (/api → http://localhost:8000)
# 프로덕션: https://your-alb-dns.ap-northeast-2.elb.amazonaws.com
VITE_API_BASE_URL=

# 배치 폴링 간격 (ms, 기본 3000)
VITE_BATCH_POLL_INTERVAL_MS=3000
