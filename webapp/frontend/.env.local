# ──────────────────────────────────────────────────────────────────────────────
# DGUDILI Frontend — 로컬 개발 환경 변수
# 이 파일은 .gitignore에 추가하세요 (민감 정보 포함 가능).
# ──────────────────────────────────────────────────────────────────────────────

# 개발 시 빈 문자열로 두면 Vite dev server가 /api/* → localhost:8000 으로 자동 프록시
VITE_API_BASE_URL=

# 배치 폴링 간격 (ms)
VITE_BATCH_POLL_INTERVAL_MS=3000
