# ──────────────────────────────────────────────────────────────────────────────
# DGUDILI Backend 환경 변수
#
# 사용법:
#   로컬 개발: cp .env.example .env  (기본값으로 바로 실행 가능)
#   Docker/AWS: 필요한 값만 환경 변수로 오버라이드
# ──────────────────────────────────────────────────────────────────────────────

# ── 모델 가중치 경로 ─────────────────────────────────────────────────────────
# 기본값: webapp/backend/weights/pretrained_graph_encoder.pt
# 로컬 개발 시 학습된 최신 가중치를 가리키도록 변경
MODEL_WEIGHTS_PATH=weights/pretrained_graph_encoder.pt

# ── 연산 장치 ────────────────────────────────────────────────────────────────
# auto  → torch.cuda.is_available() 자동 판단
# cpu   → CPU 강제 (ECS Fargate, 로컬 맥)
# cuda  → GPU 강제
DEVICE=auto

# ── DILI 임계값 ──────────────────────────────────────────────────────────────
# P(DILI) >= 이 값이면 HIGH RISK로 분류 (0~1, 기본 0.45)
DILI_THRESHOLD=0.45

# ── CORS ─────────────────────────────────────────────────────────────────────
# 로컬 개발: "*" (모두 허용)
# 프로덕션: 실제 CloudFront 도메인으로 제한
ALLOWED_ORIGINS=*

# ── AWS S3 연동 (배치 결과 저장) ─────────────────────────────────────────────
# 로컬 개발: S3_ENABLED=false → boto3 연결 시도 없이 인메모리 결과 유지
# 프로덕션: S3_ENABLED=true, S3_BUCKET_NAME, AWS_REGION 설정 필요
S3_ENABLED=false
S3_BUCKET_NAME=dgudili-batch-results
AWS_REGION=ap-northeast-2

# ── 로깅 레벨 ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 배치 처리 ────────────────────────────────────────────────────────────────
MAX_BATCH_ROWS=5000
BATCH_CHUNK_SIZE=32
